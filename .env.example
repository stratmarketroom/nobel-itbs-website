# Public browser-safe Supabase values.
# Use `supabase status` after `npm run supabase:start` to get local values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Server-only Supabase value. Never expose this in browser/client code.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Public content reads Supabase by default. Use `seed` only for explicit offline development.
CONTENT_DATA_SOURCE=supabase

# Server-only public-contact protection. Use at least 32 random characters.
CONTACT_RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters

# Optional replaceable CAPTCHA verification endpoint and server secret.
CONTACT_CAPTCHA_VERIFY_URL=
CONTACT_CAPTCHA_SECRET=

# Server-only credential verification token protection.
# Use two independent secrets. The encryption key must be exactly 32 random bytes encoded as base64.
CREDENTIAL_TOKEN_HMAC_SECRET=replace-with-an-independent-secret-of-at-least-32-characters
CREDENTIAL_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
CREDENTIAL_TOKEN_ENCRYPTION_KEY_VERSION=1

# Preferred independent secret for public credential-verification rate limiting.
# If omitted, CONTACT_RATE_LIMIT_SECRET is used with a separate HMAC namespace.
CREDENTIAL_VERIFICATION_RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters

# Optional canonical public origin used in credential verification links inside email.
# When empty in local development, the current request origin is used.
PUBLIC_SITE_URL=

# Server-only VEDOS SMTP configuration for credential PDF delivery.
# Port 587 uses STARTTLS and therefore CREDENTIAL_SMTP_SECURE=false.
# Port 465 uses implicit TLS and therefore CREDENTIAL_SMTP_SECURE=true.
CREDENTIAL_SMTP_HOST=wes1-smtp.wedos.net
CREDENTIAL_SMTP_PORT=587
CREDENTIAL_SMTP_SECURE=false
CREDENTIAL_SMTP_USERNAME=documents@nobel-itbs.eu
CREDENTIAL_SMTP_PASSWORD=
CREDENTIAL_EMAIL_FROM=documents@nobel-itbs.eu
CREDENTIAL_EMAIL_FROM_NAME=Nobel ITBS
CREDENTIAL_EMAIL_REPLY_TO=documents@nobel-itbs.eu

# Private destination for new contact-submission notifications.
CONTACT_NOTIFICATION_EMAIL=info@nobel-itbs.eu

# Legacy dormant PCE-004 contact-email adapter only. Do not configure for
# credential delivery; PCE-005 replaces contact email with Telegram.
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WORKSPACE_PRIVATE_KEY=
GOOGLE_WORKSPACE_DELEGATED_USER=
